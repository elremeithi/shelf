<?xml version="1.0" encoding="utf-8"?>
<!-- Home servers are often plain http on the LAN, or https with a self-made certificate
     installed on the phone, so both are accepted. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
