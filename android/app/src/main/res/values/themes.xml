<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/panel</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/accent_dark</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:actionBarStyle">@style/Bar</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/dim</item>
    </style>
    <style name="Bar" parent="android:Widget.Material.Light.ActionBar.Solid">
        <item name="android:background">@color/bg</item>
        <item name="android:elevation">0dp</item>
        <item name="android:titleTextStyle">@style/BarTitle</item>
    </style>
    <style name="BarTitle" parent="android:TextAppearance.Material.Widget.ActionBar.Title">
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="BrowseTheme" parent="AppTheme">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>
</resources>
